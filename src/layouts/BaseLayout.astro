---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = '3行日記' } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-50 text-zinc-900">
    <header class="mx-auto max-w-2xl px-4 pt-8 pb-6">
      <a href="/" class="text-2xl font-bold tracking-tight">3行日記</a>
      <p class="mt-2 text-sm text-zinc-600">毎日の小さな記録</p>
    </header>
    <main class="mx-auto max-w-2xl px-4 pb-12">
      <slot />
    </main>
  </body>
</html>